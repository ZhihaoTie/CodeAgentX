# CodeAgent-X local environment
#
# Copy values into .env for local runs. Do not commit real secrets.

# Default provider and model used by AgentLoop, the CLI, and benchmark runs.
CODEAGENTX_PROVIDER=deepseek
CODEAGENTX_MODEL=deepseek-v4-pro
CODEAGENTX_MAX_TOKENS=8192
CODEAGENTX_API_TIMEOUT_SECONDS=120
CODEAGENTX_API_MAX_RETRIES=2
CODEAGENTX_API_RETRY_BACKOFF_SECONDS=1.0

# Required when using the DeepSeek provider.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_PATH=/chat/completions
# GitHub target repository and PR publishing configuration for control-plane E2E.
# Do not commit real tokens. The local .env file is ignored by git.
CODEAGENTX_PUBLISHER_MODE=github
CODEAGENTX_GITHUB_TOKEN=REPLACE_WITH_NEW_GITHUB_TOKEN
CODEAGENTX_GITHUB_REPOSITORY=ZhihaoTie/CodeAgent
CODEAGENTX_GITHUB_BASE_BRANCH=main
CODEAGENTX_GITHUB_REMOTE_NAME=origin
CODEAGENTX_GITHUB_HEAD_BRANCH_PREFIX=codeagentx/run-
CODEAGENTX_GITHUB_API_BASE_URL=https://api.github.com
# Optional. Set this only when using real GitHub webhooks.
CODEAGENTX_GITHUB_WEBHOOK_SECRET=
# Optional default verification command for GitHub issue webhook tasks.
CODEAGENTX_GITHUB_DEFAULT_VERIFICATION_COMMAND=py -3.13 -B -m unittest discover -s tests -v

# Runtime/control-plane local endpoints.
CODEAGENTX_RUNTIME_BASE_URL=http://127.0.0.1:8765
CODEAGENTX_WORKSPACE_ROOT=../.codeagentx/control-plane/workspaces
CODEAGENTX_RUNTIME_POLL_DELAY_MS=2000
CODEAGENTX_RUNTIME_RUN_TIMEOUT_MS=1800000

# Control-plane worker limits. Set core/max to 1 for the concurrency-limit smoke.
CODEAGENTX_WORKER_CORE_POOL_SIZE=2
CODEAGENTX_WORKER_MAX_POOL_SIZE=2
CODEAGENTX_WORKER_QUEUE_CAPACITY=100
